{
  "name": "chaoye-finance-mcp",
  "version": "2.0.0",
  "description": "朝烨财务 MCP server for Codex with OpenAPI discovery, validation and operation previews",
  "license": "Apache-2.0",
  "bin": { "chaoye-finance-mcp": "src/index.js", "chaoye-finance-mcp-http": "src/http.js" },
  "files": ["src/", "README.md", "LICENSE", ".env.example"],
  "repository": { "type": "git", "url": "git+https://github.com/chuzihang123/chaoye-finance.git", "directory": "mcp-server" },
  "homepage": "https://github.com/chuzihang123/chaoye-finance/tree/main/mcp-server",
  "keywords": ["mcp", "chaoye_finance", "codex", "accounting"],
  "publishConfig": { "access": "public" },
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.js",
    "start:http": "node --env-file-if-exists=.env src/http.js",
    "test": "node --test"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  }
}
