CHAOYE_FINANCE_BASE_URL=http://127.0.0.1:2154/chaoye-api
# Option A: use a token from an authenticated browser session.
CHAOYE_FINANCE_TOKEN=
CHAOYE_FINANCE_REFRESH_TOKEN=
# Option B: credentials used by chaoye_finance_login (captcha may be required).
CHAOYE_FINANCE_USERNAME=
CHAOYE_FINANCE_PASSWORD=
CHAOYE_FINANCE_DOWNLOAD_DIR=./downloads
# Allowed upload directories as a JSON array of absolute paths. Defaults to process working directory.
# CHAOYE_FINANCE_UPLOAD_ROOTS=["E:/WorkSpace/财务/chaoye_finance","E:/资料"]
CHAOYE_FINANCE_MAX_UPLOAD_BYTES=20971520
# HTTP transport uses an independent access token of at least 32 characters.
# CHAOYE_FINANCE_MCP_TOKEN=
# CHAOYE_FINANCE_MCP_HOST=127.0.0.1
# CHAOYE_FINANCE_MCP_PORT=3155
