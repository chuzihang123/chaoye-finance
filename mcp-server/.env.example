JINBOOKS_BASE_URL=http://127.0.0.1:2154/jinbooks-api
# Option A: use a token from an authenticated browser session.
JINBOOKS_TOKEN=
JINBOOKS_REFRESH_TOKEN=
# Option B: credentials used by jinbooks_login (captcha may be required).
JINBOOKS_USERNAME=
JINBOOKS_PASSWORD=
JINBOOKS_DOWNLOAD_DIR=./downloads
# Allowed upload directories as a JSON array of absolute paths. Defaults to repository root.
# JINBOOKS_UPLOAD_ROOTS=["E:/WorkSpace/财务/jinbooks","E:/资料"]
JINBOOKS_MAX_UPLOAD_BYTES=20971520
